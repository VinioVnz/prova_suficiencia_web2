generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DB_STRING")
}

model Tipo {
  id          Int          @id @default(autoincrement())
  nome        String
  equipamentos Equipamento[]

  @@map("tipos")
}

model Equipamento {
  id       Int    @id @default(autoincrement())
  nome     String
  tipoId   Int
  tipo     Tipo   @relation(fields: [tipoId], references: [id])

  @@map("equipamentos")
}

model User {
  id Int        @id @default(autoincrement())
  username    String @unique
  password   String

  @@map("users")
}